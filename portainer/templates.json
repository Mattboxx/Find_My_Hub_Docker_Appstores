{
  "version": "2",
  "templates": [
    {
      "type": 3,
      "title": "Find My Hub",
      "description": "Multi-user Apple/Google tracker hub with time-filtered history, reversible views, guarded key rotation, backups, optional MQTT/Traccar and firmware tools. Illustrated bilingual guides.",
      "categories": ["Tracking", "IoT"],
      "platform": "linux",
      "logo": "https://raw.githubusercontent.com/Mattboxx/Find_My_Hub_Docker_Appstores/main/Apps/FindMyHub/icon.svg",
      "repository": {
        "url": "https://github.com/Mattboxx/Find_My_Hub_Docker_Appstores",
        "stackfile": "compose.yaml"
      },
      "env": [
        {"name": "FINDMY_WEB_PORT", "label": "Web UI port", "default": "8125"},
        {"name": "APPLE_SETUP_TOKEN", "label": "Optional Apple provider token", "default": ""},
        {"name": "GOOGLE_TOKEN", "label": "Optional Google provider token", "default": ""}
      ]
    }
  ]
}
