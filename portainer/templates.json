{
  "version": "2",
  "templates": [
    {
      "type": 3,
      "title": "TagRelayLab",
      "description": "Self-hosted Apple Find My / Google Find Hub Bluetooth tracker server with time-filtered history, reversible views, guarded key rotation, backups, optional MQTT/Traccar and firmware tools. Illustrated bilingual guides.",
      "categories": ["Tracking", "IoT"],
      "platform": "linux",
      "logo": "https://raw.githubusercontent.com/Mattboxx/TagRelayLab-Appstores/main/Apps/FindMyHub/icon.svg",
      "repository": {
        "url": "https://github.com/Mattboxx/TagRelayLab-Appstores",
        "stackfile": "compose.yaml"
      },
      "env": [
        {"name": "FINDMY_WEB_PORT", "label": "Web UI port", "default": "8125"},
        {"name": "APPLE_SETUP_TOKEN", "label": "Optional Apple provider token", "default": ""},
        {"name": "GOOGLE_TOKEN", "label": "Optional Google provider token", "default": ""}
      ]
    }
  ]
}
